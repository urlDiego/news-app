---
import type { Article } from "../types/news";
import imageFallback from "../assets/images/image-retro-pcs.jpg";

interface Props {
  articles?: Article[];
}
const { articles = [] } = Astro.props;
---

<section class="flex flex-col lg:flex-row">
    {
        articles.map((article, index) => (
            <article class="flex flex-1 lg:flex-row mb-8 gap-5">
                <img src={article.urlToImage || imageFallback.src} alt={article.title} class="w-25 h-25" onerror={`this.onerror=null;this.src='${imageFallback.src}'`}/>
                <div>
                    <p class="text-[2rem] font-bold text-Soft-orange">{String(index + 1).padStart(2, '0')}</p>
                    <a href={article.url} class="font-extrabold text-lg cursor-pointer hover:text-Soft-red transition-colors duration-500 text-wrap-pretty">{article.title}</a>
                    <p class="text-Dark-grayish-blue text-[0.9375rem] text-wrap-pretty">{article.description ?? 'No description available.'}</p>
                </div>
            </article>
        ))
    }
</section>
