---
import type { Article } from "../types/news";
import imageFallback from "../assets/images/image-retro-pcs.jpg";

interface Props {
  articles?: Article[];
}
const { articles = [] } = Astro.props;
---

<section class="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-12 pt-8 border-t border-gray-200">
  {
    articles.map((article, index) => (
      <article class="flex flex-row gap-4 items-start group cursor-pointer">
        <div class="w-20 h-20 shrink-0 overflow-hidden rounded-md shadow-sm">
          <img
            src={article.image_url || article.imageUrl || article.urlToImage || imageFallback.src}
            alt={article.title}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            onerror={`this.onerror=null;this.src='${imageFallback.src}'`}
          />
        </div>
        
        <div class="flex flex-col flex-1 justify-start">
          <p class="text-3xl font-bold text-Soft-orange leading-none mb-1">
            {String(index + 1).padStart(2, "0")}
          </p>
          <a
            href={article.id ? `/articles/${article.id}` : article.url}
            class="font-extrabold text-base lg:text-lg leading-tight transition-colors duration-300 mb-2 line-clamp-3 group-hover:text-Soft-red"
          >
            {article.title}
          </a>
          <p class="text-Dark-grayish-blue text-sm line-clamp-2">
            {article.description ?? "No description available."}
          </p>
        </div>
      </article>
    ))
  }
</section>
