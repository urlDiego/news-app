---
import type { NewsAPIResponse } from "../types/news";
import imageWeb3Mobile from "../assets/images/image-web-3-mobile.jpg";
import imageWeb3Desktop from "../assets/images/image-web-3-desktop.jpg";

const apiKey = import.meta.env.NEWS_API_KEY;
const url = `https://newsapi.org/v2/top-headlines?country=us&category=technology&apiKey=${apiKey}`;
let datos: NewsAPIResponse | null = null;
try {
  const respuesta = await fetch(url);
  if (!respuesta.ok) {
    throw new Error(`Error de la API: ${respuesta.status}`);
  }
  datos = await respuesta.json();
} catch (error) {
  console.error("Error al obtener datos", error);
}
interface Props {
  styles?: string;
}
const { styles } = Astro.props;
const fallbackArticle = {
  title: "The Bright Future of Web 3.0?",
  description:
    "We dive into the next evolution of the web that claims to put the power of the platforms back into the hands of the people. But is it really fulfilling its promise?",
  urlToImage: imageWeb3Desktop.src,
  url: "#",
  source: { id: "", name: "" },
  publishedAt: "",
  content: "",
};
const featuredArticle = datos?.articles?.[0] || fallbackArticle;
---

<header class={`${styles}`}>
  <div class="mb-6 xl:mb-5">
    <img
      class="sm:hidden"
      src={featuredArticle.urlToImage || imageWeb3Mobile.src}
      alt={featuredArticle.title}
      width="433"
      height="300"
    />
    <img
      class="hidden sm:block"
      src={featuredArticle.urlToImage || imageWeb3Desktop.src}
      alt={featuredArticle.title}
      width="748"
      height="500"
    />
  </div>

  <div class="flex flex-col max-w-187 xl:flex-row xl:gap-2">
    <div class="xl:flex-1">
      <h1
        class="text-3xl leading-tight font-bold xl:text-[2.3rem] xl:flex-1 xl:mb-0 line-clamp-4 text-wrap-pretty lg:mb-4 mb-2"
      >
        {featuredArticle.title}
      </h1>
    </div>
    <div class="xl:flex-1 flex flex-col justify-between gap-8">
      <p class="text-Dark-grayish-blue text-[0.9375rem] text-wrap-pretty">
        {featuredArticle.description}
      </p>
      <button
        class="bg-Soft-red uppercase px-8 py-3 font-bold cursor-pointer hover:bg-Soft-red/90 transition duration-300 self-start"
        >Read more</button
      >
    </div>
  </div>
</header>
