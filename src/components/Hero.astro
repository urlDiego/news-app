---
import type { Article } from "../types/news";
import imageWeb3Mobile from "../assets/images/image-web-3-mobile.jpg";
import imageWeb3Desktop from "../assets/images/image-web-3-desktop.jpg";

interface Props {
  styles?: string;
  article?: Article;
}
const { styles, article } = Astro.props;
const fallbackArticle = {
  title: "The Bright Future of Web 3.0?",
  description:
    "We dive into the next evolution of the web that claims to put the power of the platforms back into the hands of the people. But is it really fulfilling its promise?",
  urlToImage: imageWeb3Desktop.src,
  url: "#",
  source: { id: "", name: "" },
  publishedAt: "",
  content: "",
};
const featuredArticle = article || fallbackArticle;
---

<header class={`${styles} flex flex-col`}>
  <div class="mb-6 xl:mb-5">
    <img
      class="sm:hidden"
      src={featuredArticle.image_url || featuredArticle.urlToImage || imageWeb3Mobile.src}
      alt={featuredArticle.title}
      width="433"
      height="300"
      onerror={`this.onerror=null;this.src='${imageWeb3Mobile.src}'`}
    />
    <img
      class="hidden sm:block"
      src={featuredArticle.image_url || featuredArticle.urlToImage || imageWeb3Desktop.src}
      alt={featuredArticle.title}
      width="748"
      height="500"
      onerror={`this.onerror=null;this.src='${imageWeb3Desktop.src}'`}
    />
  </div>

  <div class="flex flex-col flex-1 max-w-187 xl:flex-row xl:gap-2">
    <div class="xl:flex-1">
      <h1
        class="text-3xl leading-tight font-bold xl:text-[2.3rem] xl:flex-1 xl:mb-0 line-clamp-6 text-wrap-pretty lg:mb-4 mb-2"
      >
        {featuredArticle.title}
      </h1>
    </div>
    <div class="xl:flex-1 flex flex-col justify-between gap-8">
      <p class="text-Dark-grayish-blue text-[0.9375rem] text-wrap-pretty">
        {featuredArticle.description ?? "No description available."}
      </p>
      <a
        href={featuredArticle.id ? `/articles/${featuredArticle.id}` : featuredArticle.url}
        class="bg-Soft-red uppercase px-8 py-3 font-bold text-Off-white cursor-pointer hover:bg-Very-dark-blue transition duration-300 self-start"
      >
        Read more
      </a>
    </div>
  </div>
</header>
