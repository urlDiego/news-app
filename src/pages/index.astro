---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import New from "../components/New.astro";
import Articles from "../components/articles.astro";

const apiUrl = import.meta.env.PUBLIC_API_URL;
let articles: any[] = [];

try {
  const respuesta = await fetch(`${apiUrl}/api/articles?limit=10`);
  if (!respuesta.ok) {
    throw new Error(`Error de la API: ${respuesta.status}`);
  }
  articles = await respuesta.json();
} catch (error) {
  console.error("Error al obtener datos:", error);
}
---

<Layout>
  <div class="flex flex-col lg:flex-row gap-6 mb-12 items-stretch">
    <Hero styles="flex-2" article={articles[0]} />
    <New styles="flex-1" articles={articles.slice(1, 4)} />
  </div>
  <Articles articles={articles.slice(4, 7)} />
</Layout>