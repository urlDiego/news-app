---
import Layout from "../layouts/Layout.astro";
import ArticlesList from "../components/ArticlesList.astro";
import type { Article } from "../types/news";

interface Category {
  id: number;
  name: string;
  slug: string;
}

interface CategoryGroup {
  category: Category;
  articles: Article[];
}

const apiUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:3001";
let categoryGroups: CategoryGroup[] = [];

try {
  const catRes = await fetch(`${apiUrl}/api/categories`);
  if (catRes.ok) {
    const cats: Category[] = await catRes.json();
    const results = await Promise.all(
      cats.map(async (cat) => {
        try {
          const res = await fetch(`${apiUrl}/api/articles/category/${cat.slug}`);
          const articles: Article[] = res.ok ? await res.json() : [];
          return { category: cat, articles };
        } catch {
          return { category: cat, articles: [] };
        }
      })
    );
    categoryGroups = results.filter((g) => g.articles.length > 0);
  }
} catch (error) {
  console.error("Error loading categories:", error);
}
---

<Layout>
  <div class="mb-10">
    <h1 class="text-[2.5rem] font-extrabold text-Very-dark-blue mb-2">Categories</h1>
    <p class="text-Dark-grayish-blue text-sm">
      Browse top headlines grouped by topic.
    </p>
  </div>

  <div class="flex flex-col gap-12">
    {categoryGroups.map(({ category, articles }) => (
      <section class="border-b border-Grayish-blue/20 pb-12 last:border-none">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl font-extrabold text-Very-dark-blue">
            {category.name}
          </h2>
          <span class="text-xs uppercase tracking-wider font-bold text-Soft-red bg-Soft-red/10 px-3 py-1 rounded-full">
            {articles.length} articles
          </span>
        </div>
        <ArticlesList articles={articles.slice(0, 4)} />
      </section>
    ))}
  </div>
</Layout>
