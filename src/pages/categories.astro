---
import Layout from "../layouts/Layout.astro";
import ArticlesList from "../components/ArticlesList.astro";
import type { NewsAPIResponse } from "../types/news";
const apiKey = import.meta.env.NEWS_API_KEY;
const urlTech = `https://newsapi.org/v2/top-headlines?country=us&category=technology&apiKey=${apiKey}`;
const urlScience = `https://newsapi.org/v2/top-headlines?country=us&category=science&apiKey=${apiKey}`;
const urlSports = `https://newsapi.org/v2/top-headlines?country=us&category=sports&apiKey=${apiKey}`;
let techData: NewsAPIResponse | null = null;
let scienceData: NewsAPIResponse | null = null;
let sportsData: NewsAPIResponse | null = null;
try {
    [techData, scienceData, sportsData] = await Promise.all([
        fetch(urlTech).then((r) => r.json()),
        fetch(urlScience).then((r) => r.json()),
        fetch(urlSports).then((r) => r.json()),
    ]);
} catch (error) {
    console.error("Error al obtener datos", error);
}

---

<Layout>
  <h1 class="text-[2.5rem] font-extrabold mb-4">Categories</h1>
  <section class="mb-6">
    <h2 class="text-2xl font-extrabold mb-4">Technology</h2>
    <ArticlesList articles={techData?.articles.slice(0, 3)} />
  </section>
  <section class="mb-6">
    <h2 class="text-2xl font-extrabold mb-4">Science</h2>
    <ArticlesList articles={scienceData?.articles.slice(0, 3)} />
  </section>
  <section class="mb-6">
    <h2 class="text-2xl font-extrabold mb-4">Sports</h2>
    <ArticlesList articles={sportsData?.articles.slice(0, 3)} />
  </section>
</Layout>
