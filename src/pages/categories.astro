---
import Layout from "../layouts/Layout.astro";
import ArticlesList from "../components/ArticlesList.astro";

const apiUrl = import.meta.env.PUBLIC_API_URL;
const urlTech = `${apiUrl}/api/articles/category/technology`;
const urlScience = `${apiUrl}/api/articles/category/science`;
const [techRes, scienceRes] = await Promise.all([
  fetch(urlTech),
  fetch(urlScience),
]);
const techArticles = techRes.ok ? await techRes.json() : [];
const scienceArticles = scienceRes.ok ? await scienceRes.json() : [];

let articles: any[] = [];
---

<Layout>
  <h1 class="text-[2.5rem] font-extrabold mb-6">Categories</h1>

  <section class="mb-10">
    <h2 class="text-2xl font-extrabold mb-4">Technology</h2>
    <ArticlesList articles={techArticles.slice(0, 5)} />
  </section>

  <section class="mb-10">
    <h2 class="text-2xl font-extrabold mb-4">Science</h2>
    <ArticlesList articles={scienceArticles.slice(0, 5)} />
  </section>
</Layout>

