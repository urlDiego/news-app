---
import Layout from "../layouts/Layout.astro"
import type { NewsAPIResponse } from "../types/news";
import ArticlesList from "../components/ArticlesList.astro";
const apiKey = import.meta.env.NEWS_API_KEY;
const url = `https://newsapi.org/v2/top-headlines?sources=bbc-news&apiKey=${apiKey}`;
let datos: NewsAPIResponse | null = null;
try {
  const respuesta = await fetch(url);
  if (!respuesta.ok) throw new Error(`Error: ${respuesta.status}`);
  datos = await respuesta.json();
} catch (error) {
  console.error("Error al obtener datos", error);
}
const articles = datos?.articles ?? [];

---

<Layout>
    <h1 class="text-[2.5rem] font-extrabold mb-4">New</h1>
    <ArticlesList articles={articles.slice(0, 10)} />
</Layout>