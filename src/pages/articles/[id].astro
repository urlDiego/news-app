---
import Layout from "../../layouts/Layout.astro";
const { id } = Astro.params;
const apiUrl = import.meta.env.PUBLIC_API_URL;
const response = await fetch(`${apiUrl}/api/articles/${id}`);
if (!response.ok) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}
const article = await response.json();
const formattedDate = article.published_at
  ? new Date(article.published_at).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "Recent";
const isoDate = article.published_at
  ? new Date(article.published_at).toISOString()
  : undefined;
---

<Layout>
  <section class="max-w-4xl mx-auto px-4 py-8">
    <a
      href="/"
      class="text-Soft-red hover:underline mb-6 inline-block font-bold text-sm tracking-wide"
    >
      ← Back to home
    </a>

    <article class="flex flex-col gap-6">
      <h1 class="text-3xl lg:text-4xl font-extrabold text-Very-dark-blue leading-tight">
        {article.title}
      </h1>

      <div class="flex items-center justify-between border-b border-Grayish-blue/30 pb-4">
        <div class="flex items-center gap-3 text-sm text-Dark-grayish-blue">
          <span class="font-bold text-Very-dark-blue">{article.source}</span>
          <span>•</span>
          <time datetime={isoDate}>
            {formattedDate}
          </time>
        </div>
        <button
          id="bookmark-btn"
          data-article-id={article.id}
          class="flex items-center gap-2 px-3 py-1.5 rounded border border-Grayish-blue/50 text-sm font-bold text-Very-dark-blue hover:border-Soft-red hover:text-Soft-red transition-colors cursor-pointer"
        >
          <span id="bookmark-icon">🔖</span>
          <span id="bookmark-text">Bookmark</span>
        </button>
      </div>

      {article.image_url && (
        <div class="overflow-hidden rounded-lg shadow-md max-h-112.5 w-full bg-Grayish-blue/20">
          <img
            src={article.image_url}
            alt={article.title}
            class="w-full h-full object-cover object-center"
            loading="lazy"
          />
        </div>
      )}

      <div class="text-base lg:text-lg text-Dark-grayish-blue leading-relaxed">
        <p>{article.description ?? "No description available for this article."}</p>
      </div>

      <div class="pt-4">
        <a
          href={article.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-Soft-red text-Off-white font-bold text-sm uppercase tracking-widest px-8 py-3.5 hover:bg-Very-dark-blue transition-colors duration-200 shadow-sm"
        >
          Read original article
        </a>
      </div>
    </article>
  </section>
</Layout>

<script>
  const bookmarkBtn = document.getElementById("bookmark-btn");
  const bookmarkIcon = document.getElementById("bookmark-icon");
  const bookmarkText = document.getElementById("bookmark-text");
  const articleId = bookmarkBtn?.getAttribute("data-article-id");
  const apiUrl = import.meta.env.PUBLIC_API_URL || "http://localhost:3001";
  const token = localStorage.getItem("token");

  async function checkBookmark() {
    if (!token || !articleId) return;
    try {
      const res = await fetch(`${apiUrl}/api/bookmarks/check/${articleId}`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (res.ok) {
        const data = await res.json();
        if (data.bookmarked) {
          setBookmarkedState(true);
        }
      }
    } catch (e) {
      console.error(e);
    }
  }

  function setBookmarkedState(isSaved: boolean) {
    if (bookmarkIcon && bookmarkText && bookmarkBtn) {
      if (isSaved) {
        bookmarkIcon.textContent = "★";
        bookmarkText.textContent = "Saved";
        bookmarkBtn.classList.add("bg-Soft-orange/20", "text-Soft-orange", "border-Soft-orange");
      } else {
        bookmarkIcon.textContent = "🔖";
        bookmarkText.textContent = "Bookmark";
        bookmarkBtn.classList.remove("bg-Soft-orange/20", "text-Soft-orange", "border-Soft-orange");
      }
    }
  }

  bookmarkBtn?.addEventListener("click", async () => {
    if (!token) {
      alert("Please sign in to save this article to your bookmarks");
      window.location.href = "/login";
      return;
    }

    const isCurrentlySaved = bookmarkText?.textContent === "Saved";
    const method = isCurrentlySaved ? "DELETE" : "POST";
    const endpoint = isCurrentlySaved
      ? `${apiUrl}/api/bookmarks/${articleId}`
      : `${apiUrl}/api/bookmarks`;

    try {
      const res = await fetch(endpoint, {
        method,
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${token}`,
        },
        body: method === "POST" ? JSON.stringify({ articleId }) : undefined,
      });

      if (res.ok) {
        setBookmarkedState(!isCurrentlySaved);
      }
    } catch (e) {
      console.error("Error updating bookmark:", e);
    }
  });

  checkBookmark();
</script>